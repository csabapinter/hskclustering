.DS_Store
/data/
# Rust build output, including builds inside vendored crates.
target/
# Bytecode generated by the archived experiment helpers.
__pycache__/
*.py[cod]
# Standalone upstream regression tests resolve their own development dependencies.
/vendor/linfa-clustering-0.8.1/Cargo.lock
# Regenerable multi-GB complete graph; keep it locally without adding it to Git.
/results/leiden/1-9/hsk1-9-full.graphml

# Regenerable experiment artifacts. Keep reports, settings and assignments tracked.
/results/leiden/1-9/experiments-*/experiment_tools
/results/leiden/1-9/experiments-*/graphs/*.graphml
/results/leiden/1-9/experiments-*/pca*/embeddings.txt
/results/leiden/1-9/experiments-*/pca*/pca-components.csv
/results/leiden/1-9/experiments-*/runs/*/words.csv
/results/leiden/1-9/experiments-*/baseline/words.csv

# Large GMM artifacts can be regenerated using each run's saved settings.
/results/gmm/**/memberships.csv
/results/gmm/**/model.json
# Detailed per-word geometry is regenerable from saved GMM assignments.
/results/gmm/**/runs/*/words.csv
# Per-run PCA bases are reproducible; settings, variance summaries and hashes remain tracked.
/results/gmm/**/runs/*/pca.json
# This archive has one fit per run: these files exactly duplicate communities.csv.
# Keep candidate assignments in ordinary multi-fit sweeps.
/results/gmm/1-9/experiments-2026-09-18/runs/*/k*-reg*-seed*.communities.csv

# V2's exact graphs and detailed diagnostics are regenerable from manifests.
/results/leiden-v2/**/graph.graphml
/results/leiden-v2/**/graph.json
/results/leiden-v2/**/neighbors.csv
/results/leiden-v2/**/pairs.csv
/results/leiden-v2/**/words.csv
# Solver labels duplicate the retained assignment CSVs.
/results/leiden-v2/**/solver.json
# Per-candidate records retain these aggregate measurements without duplication.
/results/leiden-v2/**/candidates.json
/results/leiden-v2/**/repeats.json
# Per-candidate sensitivity measurements also live in candidate.json.
/results/leiden-v2/**/candidates/*/sensitivity.json
# Detailed stress/sensitivity fits stay local; seeds, agreements and checksums remain.
/results/leiden-v2/**/stress/
/results/leiden-v2/**/sensitivity/*/
# Rejected pre-screening run is kept locally; its rejection record is tracked.
/results/leiden-v2/study-2026-09-25/calibration-readback-rejected/
/results/leiden-v2/study-2026-09-25/calibration-before-io-fix/
/results/leiden-v2/study-2026-09-25/screening-unbuffered-interrupted/
