.DS_Store
/data/
# Rust build output, including builds inside vendored crates.
target/
# Bytecode generated by the archived experiment helpers.
__pycache__/
*.py[cod]
# Standalone upstream regression tests resolve their own development dependencies.
/vendor/linfa-clustering-0.8.1/Cargo.lock
# Regenerable multi-GB complete graph; keep it locally without adding it to Git.
/results/leiden/1-9/hsk1-9-full.graphml

# Regenerable experiment artifacts. Keep reports, settings and assignments tracked.
/results/leiden/1-9/experiments-*/experiment_tools
/results/leiden/1-9/experiments-*/graphs/*.graphml
/results/leiden/1-9/experiments-*/pca*/embeddings.txt
/results/leiden/1-9/experiments-*/pca*/pca-components.csv
/results/leiden/1-9/experiments-*/runs/*/words.csv
/results/leiden/1-9/experiments-*/baseline/words.csv

# Large GMM artifacts can be regenerated using each run's saved settings.
/results/gmm/**/memberships.csv
/results/gmm/**/model.json
